# Copy to .env for local overrides; the Makefile loads it, Docker/Coolify set these directly.

# Directory holding tree.db and cache.db.
SPECIES_DATA_DIR=data
# Built frontend served at /.
SPECIES_STATIC_DIR=web/dist
PORT=3000

# Upstream User-Agent for enrichment. Set both in production; never hard-code them.
SPECIES_CONTACT=
SPECIES_PUBLIC_URL=

# Log level: debug, info (one line per request), warn or error.
LOG_LEVEL=info
